{
  "name": "viteboard-ai-agile",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:web": "pnpm --filter vibeboard-ai-web dev",
    "dev:api": "uv run --directory apps/api uvicorn src.main:app --reload --host 0.0.0.0 --port 8000",
    "test:api": "uv run --directory apps/api pytest",
    "migrate:api": "uv run --directory apps/api alembic upgrade head",
    "openapi:export": "uv run --directory apps/api python scripts/export_openapi.py",
    "openapi:types": "npx openapi-typescript apps/api/openapi.json -o apps/vibeboard-ai-web/src/types/api.generated.ts",
    "openapi:generate": "pnpm run openapi:export && pnpm run openapi:types"
  }
}
